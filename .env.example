NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional brand assets. Leave empty to use generated icon and Open Graph image.
NEXT_PUBLIC_LOGO_URL=
NEXT_PUBLIC_OG_IMAGE_URL=

# Public contact details — leave empty until real values exist.
# These are shown on the site. They are not used to send mail.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_LOCATION=

NEXT_PUBLIC_SOCIAL_LINKEDIN=https://www.linkedin.com/company/stacknify
NEXT_PUBLIC_SOCIAL_INSTAGRAM=https://www.instagram.com/stacknify
NEXT_PUBLIC_SOCIAL_FACEBOOK=https://www.facebook.com/stacknify
NEXT_PUBLIC_SOCIAL_PINTEREST=https://www.pinterest.com/stacknify
NEXT_PUBLIC_SOCIAL_YOUTUBE=https://www.youtube.com/@stacknify
NEXT_PUBLIC_SOCIAL_X=https://x.com/stacknify

# --- Contact form (server-only secrets: never prefix these with NEXT_PUBLIC_) ---

# Resend email delivery. Required in production.
# Create an API key at https://resend.com and verify the from domain.
RESEND_API_KEY=
CONTACT_FROM_EMAIL="Stacknify <noreply@updates.example.com>"
CONTACT_TO_EMAIL=hello@example.com

# Optional: accept submissions without sending mail (local development).
# Production ignores this unless the key/from/to values above are also set.
CONTACT_EMAIL_DRY_RUN=false

# Optional CRM/webhook copy of a sanitized inquiry. HTTPS only. Leave empty to skip.
CONTACT_WEBHOOK_URL=

# Cloudflare Turnstile. The site key is public; the secret must stay server-only.
# Required in production when Resend is sending live mail.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional extra origins if the form is posted from a different host than this
# server (comma-separated). Same-origin browser requests are allowed automatically.
# The canonical NEXT_PUBLIC_SITE_URL origin is also allowed.
CONTACT_ALLOWED_ORIGINS=

# Rate limiting. In-memory by default (one server instance).
# In production, set Upstash so limits are shared. If Upstash is configured and
# unreachable, the contact API fails closed instead of skipping limits.
CONTACT_RATE_LIMIT_MAX=5
CONTACT_EMAIL_RATE_LIMIT_MAX=3
CONTACT_RATE_LIMIT_WINDOW_SECONDS=600
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional tuning. Defaults are production-safe.
CONTACT_MIN_SUBMIT_MS=2500
CONTACT_MAX_SUBMIT_MS=43200000
CONTACT_MAX_BODY_BYTES=32768

# --- Privacy-conscious analytics ---
# Leave these empty to disable all tracking. No script is loaded until both
# provider and id are set. Supported providers: plausible, umami, fathom.
# Do not put secrets here. These values are public (they identify the site, not a user).
NEXT_PUBLIC_ANALYTICS_PROVIDER=
NEXT_PUBLIC_ANALYTICS_ID=
# Optional. Defaults: Plausible manual script, Umami Cloud, Fathom CDN.
NEXT_PUBLIC_ANALYTICS_SRC=
# Set to false if you do not want to honor DNT / Global Privacy Control.
NEXT_PUBLIC_ANALYTICS_RESPECT_DNT=true
